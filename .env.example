APP_NAME=BudgetFlow
APP_ENV=local

APP_UID=1000
APP_GID=1000

API_APP_URL=http://localhost:8086
API_LOCAL_PORT=8086
WEB_APP_URL=http://localhost:3000
WEB_LOCAL_PORT=3000

POSTGRES_DB=budgetflow
POSTGRES_USER=budgetflow
POSTGRES_PASSWORD=secret
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CACHE_DB=1
REDIS_QUEUE=default

REVERB_APP_ID=budgetflow-local
REVERB_APP_KEY=budgetflow-local-key
REVERB_APP_SECRET=budgetflow-local-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_PUBLIC_HOST=localhost
REVERB_PUBLIC_PORT=8091
